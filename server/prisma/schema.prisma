generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  candidate
  recruiter
  particulier
  admin
  agent
  /// Compte de suivi pour un talent non-diplômé (§7.3.14 inchangé : ce
  /// compte observe son statut, il ne crée ni ne modifie jamais le
  /// TalentProfile vérifié — toujours créé par l'agent).
  talent
}

enum Gender {
  femme
  homme
  autre
}

/// Pipeline talent non-diplômé : jamais automatique au-delà d'une action
/// explicite de l'agent (cahier des charges §7.3 règle 14).
enum TalentStatus {
  en_attente
  verifie
  recommande
  place
}

enum ApplicationStatus {
  envoyee
  vue
  contactee
  refusee
}

enum AccountTier {
  gratuit
  premium
}

/// Suivi déclaratif du success fee — jamais de paiement automatisé au MVP.
enum PlacementStage {
  etape1_due
  etape1_payee
  etape2_due
  etape2_payee
  annule
}

/// Pipeline de modération : Warning -> Restriction -> Suspension -> Bannissement.
enum UserStatus {
  active
  warned
  restricted
  suspended
  banned
}

enum ReportTargetType {
  opportunity
  provider
  recommendation
  user
  /// Recommandation d'un talent ou d'une entreprise.
  endorsement
  /// Fiche publique d'un talent (« Talents recommandés ») ; `targetId` = id
  /// du TalentProfile (le client envoie le `publicRef`, résolu côté serveur).
  talent
  /// Fiche publique d'une entreprise (`/entreprises/:id`) ; `targetId` = id
  /// de la Company.
  company
}

enum ReportStatus {
  open
  resolved
}

enum ModerationActionType {
  dismiss
  warning
  restriction
  suspension
  ban
}

enum OpportunityType {
  emploi
  stage
  mission
  freelance
  alternance
}

enum ExperienceLevel {
  debutant
  junior
  intermediaire
  senior
}

enum EducationLevel {
  bac
  licence
  master
  autodidacte
  technique
}

enum Availability {
  immediate
  m1
  m3
  flexible
}

/// Vérification humaine du CV d'un candidat diplômé : les contrôles
/// automatiques ne produisent que des drapeaux (`cvFlags`), seule une
/// personne habilitée (admin ou rôle ouvert par l'admin) passe le statut à
/// `verifie` ou `rejete`.
enum CvVerificationStatus {
  non_verifie
  verifie
  rejete
}

enum ProofType {
  facture
  photo
  aucune
}

/// Taxonomie transversale par secteur d'activité (candidats, entreprises,
/// talents, offres) — un filtre, jamais une section de navigation séparée
/// tant que le pilote n'a pas prouvé une densité suffisante par secteur.
enum Sector {
  btp
  textile_artisanat
  digital
  agroalimentaire
  services_commerce
  autre
}

/// Pipeline de la demande de contact "non-diplômé" à l'inscription —
/// distinct de TalentProfile pour ne jamais enfreindre la règle §7.3.14
/// (un profil talent n'est jamais créé sans agent responsable) : ce lead
/// n'est qu'une demande, le profil réel reste toujours créé par l'agent.
enum LeadStatus {
  nouveau
  contacte
  converti
  ignore
}

/// `talent` : signal repéré d'un potentiel profil non-diplômé à approcher.
/// `opportunity` : signal repéré d'un employeur/besoin qui pourrait publier
/// une offre sur OffRec. Distinct de `LeadStatus` "nouveau/contacte/..." qui
/// reste le statut d'avancement, réutilisé tel quel pour `SourcingLead`.
enum SourcingLeadType {
  talent
  opportunity
}

/// Code de vérification d'email à 4 chiffres, requis avant la création de
/// tout compte (`POST /auth/register`) — jamais de compte non vérifié en
/// base. `token` est généré une fois le code validé (ou le lien email
/// cliqué) et consommé à usage unique par `/auth/register`.
model EmailVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  token      String?   @unique
  createdAt  DateTime  @default(now())

  @@index([email])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())

  candidateProfile     CandidateProfile?
  recruiterProfile     RecruiterProfile?
  individualProfile    IndividualProfile?
  agentProfile         AgentProfile?
  talentAccountProfile TalentAccountProfile?
  member               Member?

  opportunities    Opportunity[]     @relation("RecruiterOpportunities")
  applications     Application[]
  matchSuggestions MatchSuggestion[]
  bookmarks        Bookmark[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  talentsManaged        TalentProfile[]
  sourcingLeads         SourcingLead[]
  talentSignalsHandled  TalentSignal[]  @relation("TalentSignalAgent")
  placementsAsRecruiter Placement[]     @relation("PlacementsAsRecruiter")
  placementsAsCandidate Placement[]     @relation("PlacementsAsCandidate")

  subscription     Subscription?
  transactions     Transaction[]
  sentMessages     Message[]      @relation("SentMessages")
  conversationsAsA Conversation[] @relation("ConversationParticipantA")
  conversationsAsB Conversation[] @relation("ConversationParticipantB")

  reportsFiled      Report[]           @relation("ReportsFiled")
  reportsAgainst    Report[]           @relation("ReportsAgainst")
  moderationActions ModerationAction[] @relation("ModerationActionsTaken")
  moderationTargets ModerationAction[] @relation("ModerationActionsReceived")

  cvSubmissions        CvSubmission[]
  cvVerifications      CvVerification[] @relation("CvVerificationsReceived")
  cvVerificationsGiven CvVerification[] @relation("CvVerificationsGiven")

  talentContactRequestsMade    TalentContactRequest[] @relation("TalentContactRequestsMade")
  talentContactRequestsHandled TalentContactRequest[] @relation("TalentContactRequestsHandled")

  /// Fiche entreprise liée à ce compte recruteur (par un admin uniquement).
  linkedCompany Company? @relation("CompanyRecruiter")
}

model CandidateProfile {
  userId                  String            @id
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                String
  phone                   String
  province                String
  city                    String
  gender                  Gender
  educationLevel          EducationLevel
  skills                  String[]
  experienceLevel         ExperienceLevel
  desiredOpportunityTypes OpportunityType[]
  availability            Availability
  cvUrl                   String?
  cvSkillsSuggested       String[]          @default([])
  /// Secteur d'intérêt déclaré — tag de filtrage, jamais une contrainte de matching.
  sector                  Sector?

  // === Données extraites du CV (JSON) ===
  /// Informations personnelles extraites du CV (nom, prénom, email, téléphone, etc.)
  cvExtractedInfo        Json?
  /// Titre professionnel extrait du CV
  cvProfessionalTitle    String?
  /// Résumé professionnel extrait du CV
  cvProfessionalSummary  String?
  /// Expériences professionnelles extraites du CV (JSON array)
  cvExperiences          Json?
  /// Formation académique extraite du CV (JSON array)
  cvEducation            Json?
  /// Certifications extraites du CV (JSON array)
  cvCertifications       Json?
  /// Projets/réalisations extraits du CV (JSON array)
  cvProjects             Json?
  /// Langues extraites du CV (JSON array)
  cvLanguages            Json?
  /// Technologie/outils extraits du CV (liste plate)
  cvTechnologies         String[]  @default([])
  /// Années d'expérience calculées à partir du CV
  cvYearsOfExperience    Int?
  /// Localisation souhaitée extraite du CV (liste)
  cvDesiredLocations     String[]  @default([])
  /// Disponibilité extraite du CV
  cvAvailability         String?
  /// Niveau de confiance de l'extraction (high/medium/low)
  cvExtractionConfidence String    @default("low")
  /// Date d'extraction du CV
  cvExtractionDate       DateTime?

  // === Lutte contre les faux CV ===
  /// Empreinte sha256 du dernier fichier accepté (détection de doublons).
  cvFileHash           String?
  /// Date de l'attestation sur l'honneur cochée au dépôt.
  cvAttestedAt         DateTime?
  /// Drapeaux des contrôles automatiques (`{ code, severity, message }[]`) —
  /// jamais décisionnels : ils éclairent la vérification humaine.
  cvFlags              Json?
  /// Remis à `non_verifie` à chaque nouveau dépôt.
  cvVerificationStatus CvVerificationStatus @default(non_verifie)
  cvVerifiedAt         DateTime?
  cvVerifiedById       String?
  cvVerificationNote   String?

  // === Consentement de matching (décision produit 2026-10-08) ===
  /// Date à laquelle le candidat a accepté qu'OffRec propose son profil aux
  /// entreprises. `null` = jamais donné, ou retiré. Vérifié côté serveur avant
  /// toute transmission à un recruteur ; jamais exposé au recruteur.
  matchingConsentAt DateTime?
}

/// Historique append-only de chaque dépôt de CV accepté — jamais modifié ni
/// supprimé : sert à la détection de doublons entre comptes (`fileHash`) et
/// à garder l'accès du candidat à ses anciens fichiers.
model CvSubmission {
  id          String   @id @default(uuid())
  candidateId String
  candidate   User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileHash    String
  flags       Json
  attestedAt  DateTime
  createdAt   DateTime @default(now())

  @@index([candidateId])
  @@index([fileHash])
}

/// Historique append-only des décisions de vérification de CV (même logique
/// que TalentVerification : une ligne par événement, jamais écrasée).
model CvVerification {
  id          String               @id @default(uuid())
  candidateId String
  candidate   User                 @relation("CvVerificationsReceived", fields: [candidateId], references: [id], onDelete: Cascade)
  /// Optionnel + SetNull : supprimer le compte d'un vérificateur ne doit
  /// jamais effacer ses décisions (historique append-only).
  verifierId  String?
  verifier    User?                @relation("CvVerificationsGiven", fields: [verifierId], references: [id], onDelete: SetNull)
  /// Uniquement `verifie` ou `rejete` (validé par Zod).
  decision    CvVerificationStatus
  note        String?
  createdAt   DateTime             @default(now())

  @@index([candidateId])
}

/// Rôles autorisés par l'admin à vérifier les CV, en plus de l'admin lui-même.
/// Jamais `candidate`/`talent` (conflit d'intérêts) ni `recruiter` (OffRec
/// reste l'intermédiaire : un recruteur n'accède pas aux coordonnées d'un
/// candidat) — voir GRANTABLE_CV_VERIFIER_ROLES.
model CvVerifierRole {
  role        UserRole @id
  grantedById String
  grantedAt   DateTime @default(now())
}

model RecruiterProfile {
  userId      String      @id
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  phone       String
  province    String
  city        String
  sector      Sector      @default(autre)
  tier        AccountTier @default(gratuit)
}

model IndividualProfile {
  userId   String @id
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String
  province String
  city     String
}

model AgentProfile {
  userId   String @id
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String
  province String
  city     String
}

model Opportunity {
  id              String          @id @default(uuid())
  recruiterId     String
  recruiter       User            @relation("RecruiterOpportunities", fields: [recruiterId], references: [id], onDelete: Cascade)
  companyName     String
  title           String
  category        String
  /// Taxonomie transversale (filtre) — distincte de `category`, qui reste
  /// la classification fine héritée des métiers de bureau.
  sector          Sector          @default(autre)
  /// Champs additionnels dépendant du secteur (ex. outils/chantier pour le
  /// BTP, stack technique pour le digital) — même pattern que
  /// TalentVerification.checklist, pas de colonnes typées pour des champs
  /// qui ne s'appliquent qu'à une partie des secteurs.
  sectorDetails   Json?
  description     String
  province        String
  city            String
  opportunityType OpportunityType
  /// Suggestions (`COMMON_SKILLS`) ou saisies libres du recruteur, libellé
  /// de la suggestion repris pour une saisie équivalente (casse, accents) —
  /// règles partagées dans `src/lib/opportunityFields.ts`.
  requiredSkills  String[]
  /// Missions du poste, dans l'ordre du recruteur (facultatives, 15 au plus,
  /// 3 à 200 caractères). Montrées au candidat avant la mise en relation :
  /// ni nom d'entreprise ni coordonnées (emails, téléphones et sites refusés
  /// par le serveur).
  missions        String[]        @default([])
  level           ExperienceLevel
  deadline        DateTime
  featured        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  /// Nombre de postes à pourvoir (décision D1 du 2026-10-16, 1 à 50, 1 par
  /// défaut). L'offre sera pourvue quand les placements non annulés qui lui
  /// sont liés atteindront ce nombre (flux d'embauche, sous-lot 5).
  positions       Int             @default(1)
  /// Offre pourvue : fermée au matching, à la présélection et aux nouvelles
  /// propositions d'embauche. `null` = ouverte (aucune reprise de données :
  /// seul le nouveau flux ou une clôture manuelle la renseigne).
  filledAt        DateTime?
  /// `'auto'` (nombre de postes atteint) ou identifiant du recruteur
  /// (clôture manuelle). Interne : jamais renvoyé par l'API.
  filledBy        String?

  applications     Application[]
  bookmarks        Bookmark[]
  talentProposals  TalentOpportunityProposal[]
  placements       Placement[]
  matchSuggestions MatchSuggestion[]

  @@index([province])
  @@index([opportunityType])
}

/// Statut de mise en relation (diplômés). Chaîne en vigueur depuis la
/// décision produit 2026-10-08 : `suggeree` (file de validation admin) →
/// `proposee_recruteur` → `interet_recruteur` → `mise_en_relation`, ou
/// `ecartee`. Depuis la décision 2026-10-14, le recruteur passe lui-même un
/// dossier `proposee_recruteur` ou `interet_recruteur` en `mise_en_relation`
/// en fixant un entretien (`Interview`) ; l'admin peut toujours confirmer
/// une ligne `interet_recruteur` existante.
enum MatchSuggestionStatus {
  /// Créée par le moteur ou par l'admin, en attente de validation admin.
  suggeree
  /// HÉRITÉ (parcours « postuler offre par offre », avant 2026-10-08) :
  /// plus jamais produit, conservé pour que les lignes existantes restent
  /// valides et puissent avancer.
  proposee_candidat
  /// HÉRITÉ — voir `proposee_candidat`.
  interet_candidat
  proposee_recruteur
  interet_recruteur
  mise_en_relation
  ecartee
}

/// Qui a créé la suggestion : le moteur de matching (`lib/matching.ts`) ou
/// un admin depuis le vivier de candidats.
enum MatchSuggestionOrigin {
  systeme
  admin
}

/// OffRec comme intermédiaire (décisions produit 2026-09-02 et 2026-10-08) :
/// ni le candidat ni le recruteur ne se contactent en direct — cette table
/// est le pendant, pour les diplômés, de TalentOpportunityProposal (non-
/// diplômés, inchangé). Créée par le moteur de matching ou par un admin,
/// jamais par un candidat ou un recruteur ; le candidat donne un
/// consentement global (`CandidateProfile.matchingConsentAt`) au lieu de
/// postuler offre par offre.
model MatchSuggestion {
  id               String                @id @default(uuid())
  opportunityId    String
  opportunity      Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        User                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  score            Int
  reasons          String[]
  status           MatchSuggestionStatus @default(suggeree)
  /// Les lignes antérieures à 2026-10-08 ont toutes été créées par un admin.
  origin           MatchSuggestionOrigin @default(admin)
  /// Rang du candidat dans la présélection ATS de l'offre au moment où un
  /// admin l'a transmis au recruteur depuis cette présélection
  /// (`lib/preselection.ts`). `null` pour un envoi direct du moteur ou une
  /// transmission unitaire. Instantané : jamais recalculé ensuite.
  preselectionRank Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  /// Date du passage en `mise_en_relation`, écrite par `commitMatchTransition`
  /// (lib/preselection-service.ts). Remplace l'approximation `updatedAt` des
  /// tableaux de bord. Reprise des lignes existantes : date du journal
  /// d'audit de la transition, sinon `updatedAt`.
  connectedAt      DateTime?
  /// Raison d'une clôture automatique, seulement sur une ligne `ecartee`
  /// (offre pourvue, sous-lot 5).
  closedReason     MatchClosedReason?
  /// Tours d'entretien fixés par le recruteur (décision 2026-10-14, tours
  /// multiples 2026-10-16) : un seul tour ACTIF à la fois
  /// (`Interview.activeSuggestionId` unique), reprogrammé ou annulé en place.
  interviews       Interview[]
  /// Propositions d'embauche successives (une seule en attente à la fois).
  proposals        HireProposal[]
  /// Placement né de ce dossier (proposition acceptée, ou déclaration reprise).
  placement        Placement?

  @@unique([opportunityId, candidateId])
  @@index([status])
  @@index([candidateId])
}

/// Pourquoi un dossier non mis en relation a été clos automatiquement.
enum MatchClosedReason {
  offre_pourvue
}

/// Statut d'un entretien (décision produit 2026-10-14).
enum InterviewStatus {
  /// Fixé (ou reprogrammé) par le recruteur, en attente de la réponse du candidat.
  planifie
  /// Le candidat a confirmé sa présence.
  confirme
  /// Le candidat a signalé un empêchement : le recruteur reprogramme ou annule.
  empechement
  /// Annulé par le recruteur.
  annule
}

/// Fournisseur de l'agenda au moment de la dernière synchronisation.
enum InterviewProvider {
  /// Vrai événement dans l'agenda Google d'OffRec (`lib/google-calendar.ts`).
  google
  /// Identifiants Google absents : aucun événement, aucun lien (développement).
  simule
}

/// État du lien de visioconférence affiché au candidat et au recruteur.
enum InterviewMeetStatus {
  /// Un lien Google Meet a été généré.
  disponible
  /// Google a échoué : la mise en relation est enregistrée, le lien est à
  /// régulariser par un admin.
  en_attente
  /// Mode simulé : aucun lien n'existe (jamais de faux `meet.google.com`).
  simule
}

/// Issue d'un tour d'entretien, renseignée par le recruteur après l'heure de
/// fin (« après l'entretien », 2026-10-16). Le candidat ne la voit jamais
/// brute : il reçoit les textes neutres d'OffRec. (Le type TS
/// `InterviewOutcome<T>` existait déjà côté serveur, d'où ce nom.)
enum InterviewResult {
  retenu
  second_entretien
  non_retenu
  absent
}

/// Motif de l'issue, en liste fermée (agrégeable) : `points_forts` pour
/// `retenu` / `second_entretien`, les autres pour `non_retenu`.
enum InterviewResultReason {
  competences_techniques
  experience
  disponibilite
  pretentions_salariales
  savoir_etre
  autre_candidat_retenu
  poste_modifie
  points_forts
  autre
}

/// Entretien fixé par le recruteur en cliquant « Ce profil m'intéresse »
/// (décision produit 2026-10-14). Sa création fait passer le dossier en
/// `mise_en_relation`. L'événement Google vit dans l'agenda d'OffRec, sans
/// aucun invité : OffRec transmet lui-même le lien à chacun (intermédiaire).
///
/// Une ligne = un tour (`round`, 1 à 3, décision D5). Un seul tour ACTIF par
/// dossier : `activeSuggestionId` vaut `suggestionId` tant que le tour n'a
/// pas d'issue, `null` ensuite ; son index unique (NULL multiples permis par
/// PostgreSQL) garantit l'unicité sans index partiel.
model Interview {
  id                 String                 @id @default(uuid())
  suggestionId       String
  suggestion         MatchSuggestion        @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  /// Numéro de tour (1 pour tous les entretiens antérieurs aux tours).
  round              Int                    @default(1)
  /// = `suggestionId` tant que le tour est actif (aucune issue), sinon `null`.
  activeSuggestionId String?                @unique
  /// Issue du tour (`null` tant qu'elle n'est pas renseignée).
  outcome            InterviewResult?
  outcomeReason      InterviewResultReason?
  /// Note privée du recruteur : renvoyée à son seul auteur (décision D3),
  /// jamais au candidat, jamais à l'admin, jamais dans le journal d'audit.
  outcomeNote        String?
  outcomeAt          DateTime?
  /// Recruteur auteur de l'issue (identifiant de compte, sans clé étrangère).
  outcomeById        String?
  /// Rappel « issue à renseigner » envoyé au recruteur (une seule fois par tour).
  outcomeReminderAt  DateTime?
  /// Explication d'absence du candidat (après une issue `absent`), lue par
  /// les admins seuls — jamais par le recruteur.
  absenceReply       String?
  absenceReplyAt     DateTime?
  /// Instant de début, en UTC (saisi en heure de Madagascar, UTC+3 fixe).
  scheduledAt        DateTime
  /// 30, 45 ou 60.
  durationMinutes    Int
  /// Message optionnel du recruteur au candidat.
  message            String?
  status             InterviewStatus        @default(planifie)
  provider           InterviewProvider
  meetStatus         InterviewMeetStatus
  meetUrl            String?
  googleEventId      String?
  /// Dernier échec de synchronisation avec Google (message court, sans
  /// secret) ; `null` quand l'agenda est à jour.
  calendarError      String?
  /// Motif court donné par le candidat avec son empêchement.
  declineReason      String?
  /// Dernière réponse du candidat (confirmation ou empêchement).
  respondedAt        DateTime?
  cancelledAt        DateTime?
  rescheduleCount    Int                    @default(0)
  /// Recruteur auteur (identifiant de compte, sans clé étrangère).
  createdById        String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  /// Remplace l'ancien `suggestionId @unique` (migration
  /// 20261016100000_interview_rounds) ; sert aussi d'index par dossier.
  @@unique([suggestionId, round])
  @@index([status])
  @@index([meetStatus])
  /// Listes « Entretiens » (recruteur, admin) : tri et périodes par date.
  @@index([scheduledAt])
  @@index([outcome])
}

enum HireProposalStatus {
  envoyee
  acceptee
  refusee
  expiree
  retiree
}

enum HireProposalWithdrawReason {
  recruteur
  poste_pourvu
  compte_inactif
}

enum ContractType {
  cdi
  cdd
  stage
  alternance
  freelance
}

/// Motif (facultatif) d'un refus de proposition par le candidat.
enum HireDeclineReason {
  salaire
  date_debut
  type_contrat
  autre_offre_acceptee
  localisation
  raisons_personnelles
  autre
}

/// Proposition d'embauche du recruteur à un candidat retenu (2026-10-16).
/// Versions successives par dossier (`version`) ; une seule en attente à la
/// fois : `pendingSuggestionId` vaut `suggestionId` tant que le statut est
/// `envoyee`, `null` ensuite (index unique, même motif que
/// `Interview.activeSuggestionId`). Expire 7 jours après l'envoi ou la
/// dernière modification (décision D2) ; le candidat accepte la révision
/// (`revision`) qu'il a lue.
model HireProposal {
  id                     String                      @id @default(uuid())
  suggestionId           String
  suggestion             MatchSuggestion             @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  /// = `suggestionId` tant que `status = envoyee`, sinon `null`.
  pendingSuggestionId    String?                     @unique
  /// n-ième proposition du dossier.
  version                Int                         @default(1)
  jobTitle               String
  monthlySalaryAr        Int
  /// Jour civil (Madagascar).
  startDate              DateTime                    @db.Date
  contractType           ContractType
  /// Obligatoire pour `cdd` et `stage`.
  contractDurationMonths Int?
  message                String?
  status                 HireProposalStatus          @default(envoyee)
  expiresAt              DateTime
  /// Incrémenté à chaque modification.
  revision               Int                         @default(0)
  respondedAt            DateTime?
  declineReason          HireDeclineReason?
  /// Précision du refus : lue par le candidat et l'admin, jamais par le
  /// recruteur (décision D3), jamais dans le journal d'audit.
  declineNote            String?
  withdrawnAt            DateTime?
  withdrawReason         HireProposalWithdrawReason?
  expiryReminderAt       DateTime?
  /// Recruteur auteur (identifiant de compte, sans clé étrangère).
  createdById            String
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  placement              Placement?

  @@unique([suggestionId, version])
  @@index([status, expiresAt])
}

model Application {
  id            String            @id @default(uuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  message       String?
  status        ApplicationStatus @default(envoyee)
  createdAt     DateTime          @default(now())

  @@unique([opportunityId, candidateId])
}

model Bookmark {
  candidateId   String
  candidate     User        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([candidateId, opportunityId])
}

/// Origine d'une notification destinée aux administrateurs (`notifyAdmins()`)
/// — sert uniquement à filtrer la page `/admin/notifications`. Reflétée par
/// `NotificationCategory` dans `src/types/index.ts`.
enum NotificationCategory {
  candidat
  recruteur
  agent
  systeme
  moderation
  annuaire
}

model Notification {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  /// `null` pour les notifications personnelles (candidat, recruteur…) et
  /// pour toutes celles créées avant l'ajout de la colonne.
  category  NotificationCategory?
  /// Chemin frontend (ex. `/messages?c=...`, `/candidat/offres/...`) — la
  /// notification navigue vers sa source au clic, jamais générique.
  link      String?
  read      Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@index([userId])
}

model Member {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  district      String
  city          String   @default("Antananarivo")
  phoneVerified Boolean  @default(false)
  joinedAt      DateTime @default(now())

  providersAdded   Provider[]                   @relation("AddedByMember")
  providersClaimed Provider[]                   @relation("ClaimedByMember")
  recommendations  Recommendation[]
  confirmations    RecommendationConfirmation[]
  endorsements     Endorsement[]
  companiesCreated Company[]                    @relation("CompaniesCreated")
}

model Provider {
  id                String   @id @default(uuid())
  name              String
  trade             String
  description       String   @default("")
  district          String
  city              String   @default("Antananarivo")
  province          String   @default("Antananarivo")
  phone             String
  whatsapp          String?
  addedByMemberId   String
  addedByMember     Member   @relation("AddedByMember", fields: [addedByMemberId], references: [id])
  claimedByMemberId String?
  claimedByMember   Member?  @relation("ClaimedByMember", fields: [claimedByMemberId], references: [id])
  createdAt         DateTime @default(now())

  recommendations Recommendation[]

  @@index([trade])
  @@index([district])
}

model Recommendation {
  id             String    @id @default(uuid())
  providerId     String
  provider       Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  authorMemberId String
  authorMember   Member    @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)
  authorDistrict String
  rating         Int
  wouldUseAgain  Boolean
  jobLabel       String
  jobDate        DateTime
  pricePaid      Int?
  priceUnit      String?
  comment        String
  proof          ProofType @default(aucune)
  createdAt      DateTime  @default(now())

  confirmations RecommendationConfirmation[]

  @@unique([providerId, authorMemberId])
  @@index([providerId])
}

model RecommendationConfirmation {
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([recommendationId, memberId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AiInteraction {
  id            String   @id @default(uuid())
  userId        String?
  feature       String
  promptSummary String
  flagged       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// Messagerie interne (candidat <-> recruteur, particulier <-> annuaire…)

model Conversation {
  id             String   @id @default(uuid())
  participantAId String
  participantA   User     @relation("ConversationParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User     @relation("ConversationParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  /// Contexte optionnel : l'offre à l'origine de la conversation.
  opportunityId  String?
  createdAt      DateTime @default(now())

  messages Message[]

  @@unique([participantAId, participantBId, opportunityId])
  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// Abonnements entreprise + paiement simulé

/// Grille tarifaire centralisée — jamais de prix codé en dur côté frontend.
model SubscriptionPlan {
  code                   String   @id
  name                   String
  priceAr                Int
  maxActiveOpportunities Int?
  features               String[]

  subscriptions Subscription[]
}

model Subscription {
  id          String           @id @default(uuid())
  recruiterId String           @unique
  recruiter   User             @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  planCode    String
  plan        SubscriptionPlan @relation(fields: [planCode], references: [code])
  startedAt   DateTime         @default(now())
}

/// Paiement simulé : hypothèse de démonstration, pas une intégration réelle.
model Transaction {
  id          String   @id @default(uuid())
  recruiterId String
  recruiter   User     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  type        String
  amountAr    Int
  description String
  createdAt   DateTime @default(now())

  @@index([recruiterId])
}

// Modération : Warning -> Restriction -> Suspension -> Bannissement.

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  reporter     User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  targetId     String
  /// Utilisateur responsable du contenu signalé, résolu côté serveur.
  targetUserId String?
  targetUser   User?            @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: SetNull)
  reason       String
  status       ReportStatus     @default(open)
  createdAt    DateTime         @default(now())

  moderationAction ModerationAction?

  @@index([status])
}

model ModerationAction {
  id           String               @id @default(uuid())
  reportId     String?              @unique
  report       Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)
  adminId      String
  admin        User                 @relation("ModerationActionsTaken", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?                @relation("ModerationActionsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       ModerationActionType
  note         String?
  createdAt    DateTime             @default(now())
}

// Verticale emploi vérifié : agents de terrain, talents non-diplômés,
// placements et success fee (cahier des charges §7.3, §8 phases F-I).

/// Créé et modifié uniquement par l'agent qui le suit (§7.3 règle 14) :
/// pas de compte de connexion propre au MVP.
model TalentProfile {
  id              String       @id @default(uuid())
  agentId         String
  agent           User         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fullName        String
  phone           String
  province        String
  city            String
  gender          Gender
  /// Métier déclaré à la création (repris d'un TalentLead ou saisi par
  /// l'agent) — pilote la grille de vérification standardisée (§7.3.15).
  trade           String       @default("")
  sector          Sector       @default(autre)
  skills          String[]
  availability    Availability
  status          TalentStatus @default(en_attente)
  /// Accord de la personne pour avoir un profil OffRec et être proposée à
  /// des entreprises, recueilli par l'agent à la création (obligatoire
  /// depuis le lot 3). `null` : profil antérieur, accord non tracé.
  consentAt       DateTime?
  /// Quartier déclaré (facultatif) — affiché à côté de la ville.
  district        String?
  /// 9 derniers chiffres normalisés du téléphone (`phoneKeyOf`) — rattache
  /// une nouvelle recommandation au talent existant. Jamais affiché.
  phoneKey        String?
  /// Accord EXPLICITE de la personne pour une fiche publique (« Talents
  /// recommandés »), distinct de `consentAt`, recueilli par l'agent,
  /// révocable. Historique dans `AuditLog` (`talent_consent_public_*`).
  publicConsentAt DateTime?
  /// Identifiant public aléatoire de la fiche (jamais l'id), régénéré à
  /// chaque nouvel accord, remis à `null` au retrait : l'ancien lien meurt.
  publicRef       String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  verifications   TalentVerification[]
  contactRequests TalentContactRequest[]
  proposals       TalentOpportunityProposal[]
  placements      Placement[]
  accountProfile  TalentAccountProfile?
  sourcedFrom     SourcingLead[]
  signals         TalentSignal[]

  @@index([agentId])
  @@index([phoneKey])
}

enum ContactRequestStatus {
  nouvelle
  transmise
  close
}

/// Demande de contact envoyée depuis la fiche publique d'un talent : OffRec
/// reste l'intermédiaire — l'agent du talent la traite et organise le
/// contact hors ligne ; la plateforme ne met jamais les deux en relation.
model TalentContactRequest {
  id          String               @id @default(uuid())
  talentId    String
  talent      TalentProfile        @relation(fields: [talentId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User                 @relation("TalentContactRequestsMade", fields: [requesterId], references: [id], onDelete: Cascade)
  /// Besoin décrit par le demandeur (≤ 1000 caractères), lu par l'agent.
  need        String
  status      ContactRequestStatus @default(nouvelle)
  handledById String?
  handledBy   User?                @relation("TalentContactRequestsHandled", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  createdAt   DateTime             @default(now())

  @@index([talentId])
  @@index([status])
  @@index([requesterId])
}

/// Demande de contact "je n'ai pas de diplôme mais je sais faire un
/// métier" déposée en self-service à l'inscription. Ne crée jamais elle-
/// même de TalentProfile — un agent reprend la demande et le crée
/// (§7.3.14). Peut en revanche être liée à un TalentAccountProfile
/// (compte de suivi, décision produit 2026-09-02) si la personne choisit
/// de "poursuivre vers l'inscription" après sa demande.
model TalentLead {
  id        String     @id @default(uuid())
  fullName  String
  phone     String
  province  String
  city      String
  gender    Gender
  trade     String
  sector    Sector
  message   String?
  status    LeadStatus @default(nouveau)
  createdAt DateTime   @default(now())

  accountProfile TalentAccountProfile?

  @@index([status])
}

/// Piste de veille journalisée par un agent (en ligne ou sur le terrain) :
/// jamais un profil ni une offre en soi, seulement un signal à vérifier
/// soi-même — l'annuaire ne s'étoffe qu'après un vrai contact et, pour un
/// talent, la même vérification humaine que n'importe quel TalentProfile
/// (§7.3.15). Distinct de TalentLead (déposé en self-service par la
/// personne elle-même) : ici c'est l'agent qui a repéré le signal.
model SourcingLead {
  id          String           @id @default(uuid())
  agentId     String
  agent       User             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type        SourcingLeadType
  /// D'où vient le signal — ex. "Groupe Facebook Bâtiment Antananarivo",
  /// "Affiche quartier Analakely", "Bouche-à-oreille".
  source      String
  sourceUrl   String?
  trade       String
  sector      Sector
  province    String
  city        String
  description String
  status      LeadStatus       @default(nouveau)
  /// Rempli seulement si type=talent et que la piste a donné lieu à un
  /// vrai TalentProfile vérifié.
  talentId    String?
  talent      TalentProfile?   @relation(fields: [talentId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([agentId])
  @@index([status])
}

/// Compte de suivi d'un talent non-diplômé (décision produit 2026-09-02) :
/// un vrai compte de connexion, mais qui n'a AUCUN pouvoir d'écriture sur
/// TalentProfile — il observe uniquement le statut de la demande (`lead`)
/// puis, une fois qu'un agent l'a repris, le statut réel du profil vérifié
/// (`talent`). Le profil vérifié et la grille de compétences restent
/// exclusivement créés/remplis par l'agent (§7.3.14 inchangé).
model TalentAccountProfile {
  userId   String @id
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String
  province String
  city     String
  gender   Gender

  leadId   String?        @unique
  lead     TalentLead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  talentId String?        @unique
  talent   TalentProfile? @relation(fields: [talentId], references: [id], onDelete: SetNull)
}

/// Un enregistrement par événement de vérification : historique conservé,
/// jamais écrasé (cohérent avec §7 « aucune suppression »).
model TalentVerification {
  id         String        @id @default(uuid())
  talentId   String
  talent     TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  trade      String
  checklist  Json
  note       String?
  verifiedAt DateTime      @default(now())

  @@index([talentId])
}

/// Historique des opportunités proposées à ce talent (cahier MVP §4.1) ;
/// côté « vérifié humain » d'une shortlist (§7.3 règle 17).
model TalentOpportunityProposal {
  id            String        @id @default(uuid())
  talentId      String
  talent        TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  proposedAt    DateTime      @default(now())

  @@unique([talentId, opportunityId])
  @@index([opportunityId])
}

/// Exactement un de candidateId/talentId renseigné — vérifié en code
/// (validation Zod), pas en contrainte DB.
model Placement {
  id              String           @id @default(uuid())
  opportunityId   String?
  opportunity     Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  recruiterId     String
  recruiter       User             @relation("PlacementsAsRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateId     String?
  candidate       User?            @relation("PlacementsAsCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  talentId        String?
  talent          TalentProfile?   @relation(fields: [talentId], references: [id], onDelete: SetNull)
  monthlySalaryAr Int?
  stage           PlacementStage   @default(etape1_due)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  /// Dossier diplômé d'origine. `SetNull` et non `Cascade` : supprimer
  /// l'offre supprime ses `MatchSuggestion` (cascade) mais le suivi du
  /// success fee doit survivre, comme `opportunityId`. Reprise : le plus
  /// ancien placement non annulé de chaque paire offre/candidat.
  suggestionId    String?          @unique
  suggestion      MatchSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  /// Proposition d'embauche acceptée dont il est né (flux automatique).
  hireProposalId  String?          @unique
  hireProposal    HireProposal?    @relation(fields: [hireProposalId], references: [id], onDelete: SetNull)
  origin          PlacementOrigin  @default(declaration)
  jobTitle        String?
  /// Jour civil (Madagascar).
  startDate       DateTime?        @db.Date
  contractType    ContractType?

  @@index([recruiterId])
}

/// Origine d'un placement : déclaration du recruteur (talents, historique)
/// ou acceptation d'une proposition d'embauche (diplômés, automatique).
enum PlacementOrigin {
  declaration
  proposition_acceptee
}

// Recommandations de talents (et, plus tard, d'entreprises) : un membre
// connecté recommande une personne qu'il a vue travailler. La recommandation
// ne crée jamais de profil : elle alimente un signal privé, traité par un
// agent de terrain qui seul crée le TalentProfile (§7.3.14).

enum EndorsementSubject {
  talent
  entreprise
}

enum EndorsementRelation {
  client
  employeur
  collegue
  salarie
  stagiaire
  prestataire
}

/// Cycle de vie d'un signal : `nouveau` (file partagée des agents) ->
/// `pris_en_charge` -> `converti` | `refuse` | `injoignable` | `expire` |
/// `fusionne`. Transitions contrôlées côté serveur (`lib/talent-signals.ts`).
enum TalentSignalStatus {
  nouveau
  pris_en_charge
  converti
  refuse
  injoignable
  expire
  fusionne
}

/// Personne recommandée qui n'a pas (encore) de profil : regroupe les
/// recommandations qui la concernent. Le contact (`subjectName`,
/// `contactPhone`, `contactHint`) n'est visible que par l'agent qui a pris
/// le signal et par les admins ; il est purgé 60 jours après la dernière
/// activité, ou immédiatement si le signal est refusé.
model TalentSignal {
  id              String             @id @default(uuid())
  trade           String
  sector          Sector
  province        String
  city            String
  district        String
  /// « Comment l'appelez-vous ? » — PRIVÉ (agents/admins).
  subjectName     String?
  /// PRIVÉ.
  contactPhone    String?
  /// 9 derniers chiffres normalisés — dédoublonnage, jamais affiché.
  phoneKey        String?
  /// « Atelier près du marché… » — PRIVÉ.
  contactHint     String?
  status          TalentSignalStatus @default(nouveau)
  agentId         String?
  agent           User?              @relation("TalentSignalAgent", fields: [agentId], references: [id], onDelete: SetNull)
  talentId        String?
  talent          TalentProfile?     @relation(fields: [talentId], references: [id], onDelete: SetNull)
  mergedIntoId    String?
  mergedInto      TalentSignal?      @relation("TalentSignalMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom      TalentSignal[]     @relation("TalentSignalMerge")
  expiresAt       DateTime
  contactPurgedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  endorsements Endorsement[]

  @@index([status])
  @@index([phoneKey])
  @@index([talentId])
  @@index([expiresAt])
}

/// Recommandation positive d'un talent (`subjectType = talent`, rattachée à
/// un signal) ou d'une entreprise (`subjectType = entreprise`, `companyId`).
/// Jamais supprimée : un agent (un admin pour une entreprise) peut l'écarter
/// (`excludedAt`), elle ne compte alors plus. `comment` n'est jamais public ni montré au
/// recruteur.
model Endorsement {
  id             String              @id @default(uuid())
  subjectType    EndorsementSubject
  talentSignalId String?
  talentSignal   TalentSignal?       @relation(fields: [talentSignalId], references: [id], onDelete: Restrict)
  companyId      String?
  company        Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  authorMemberId String
  authorMember   Member              @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)
  authorDistrict String
  relation       EndorsementRelation
  jobLabel       String
  jobDate        DateTime
  /// Liste fermée positive (`src/data/endorsements.ts`).
  highlights     String[]
  comment        String?
  proof          ProofType           @default(aucune)
  /// `/uploads/preuves/<uuid>.<ext>` — servi avec contrôle d'accès.
  proofFileUrl   String?
  /// Revue de l'agent : seule une preuve acceptée pèse dans la confiance.
  proofAccepted  Boolean?
  reviewedAt     DateTime?
  hiddenJobLabel Boolean             @default(false)
  excludedAt     DateTime?
  excludedReason String?
  excludedById   String?
  createdAt      DateTime            @default(now())

  @@unique([talentSignalId, authorMemberId])
  @@unique([companyId, authorMemberId])
  @@index([authorMemberId])
}

/// Entreprise / employeur recommandé par d'anciens salariés, stagiaires ou
/// prestataires (`candidate`, `particulier`, `talent` uniquement). Créée à la
/// première recommandation ; dédoublonnée par `nameKey` + `city`
/// (`lib/companies.ts`). Jamais d'auteur ni de commentaire publics ; la preuve
/// (contrat, bulletin…) est revue par un admin puis supprimée du disque.
/// Liée à un compte recruteur par un admin seulement (pas d'auto-revendication).
model Company {
  id                String    @id @default(uuid())
  name              String
  /// Nom normalisé (minuscules, sans accents, ponctuation ni forme juridique).
  nameKey           String
  sector            Sector    @default(autre)
  city              String
  province          String
  recruiterUserId   String?   @unique
  recruiterUser     User?     @relation("CompanyRecruiter", fields: [recruiterUserId], references: [id], onDelete: SetNull)
  createdByMemberId String?
  createdByMember   Member?   @relation("CompaniesCreated", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  /// Masquée par un admin : n'apparaît plus nulle part (public, recherche, recruteur).
  hiddenAt          DateTime?
  hiddenReason      String?
  createdAt         DateTime  @default(now())

  endorsements Endorsement[]

  @@unique([nameKey, city])
  @@index([nameKey])
}
