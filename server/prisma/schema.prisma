generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  candidate
  recruiter
  particulier
  admin
  agent
  /// Compte de suivi pour un talent non-diplômé (§7.3.14 inchangé : ce
  /// compte observe son statut, il ne crée ni ne modifie jamais le
  /// TalentProfile vérifié — toujours créé par l'agent).
  talent
}

enum Gender {
  femme
  homme
  autre
}

/// Pipeline talent non-diplômé : jamais automatique au-delà d'une action
/// explicite de l'agent (cahier des charges §7.3 règle 14).
enum TalentStatus {
  en_attente
  verifie
  recommande
  place
}

enum ApplicationStatus {
  envoyee
  vue
  contactee
  refusee
}

enum AccountTier {
  gratuit
  premium
}

/// Suivi déclaratif du success fee — jamais de paiement automatisé au MVP.
enum PlacementStage {
  etape1_due
  etape1_payee
  etape2_due
  etape2_payee
  annule
}

/// Pipeline de modération : Warning -> Restriction -> Suspension -> Bannissement.
enum UserStatus {
  active
  warned
  restricted
  suspended
  banned
}

enum ReportTargetType {
  opportunity
  provider
  recommendation
  user
}

enum ReportStatus {
  open
  resolved
}

enum ModerationActionType {
  dismiss
  warning
  restriction
  suspension
  ban
}

enum OpportunityType {
  emploi
  stage
  mission
  freelance
  alternance
}

enum ExperienceLevel {
  debutant
  junior
  intermediaire
  senior
}

enum EducationLevel {
  bac
  licence
  master
  autodidacte
  technique
}

enum Availability {
  immediate
  m1
  m3
  flexible
}

enum ProofType {
  facture
  photo
  aucune
}

/// Taxonomie transversale par secteur d'activité (candidats, entreprises,
/// talents, offres) — un filtre, jamais une section de navigation séparée
/// tant que le pilote n'a pas prouvé une densité suffisante par secteur.
enum Sector {
  btp
  textile_artisanat
  digital
  agroalimentaire
  services_commerce
  autre
}

/// Pipeline de la demande de contact "non-diplômé" à l'inscription —
/// distinct de TalentProfile pour ne jamais enfreindre la règle §7.3.14
/// (un profil talent n'est jamais créé sans agent responsable) : ce lead
/// n'est qu'une demande, le profil réel reste toujours créé par l'agent.
enum LeadStatus {
  nouveau
  contacte
  converti
  ignore
}

/// Code de vérification d'email à 4 chiffres, requis avant la création de
/// tout compte (`POST /auth/register`) — jamais de compte non vérifié en
/// base. `token` est généré une fois le code validé (ou le lien email
/// cliqué) et consommé à usage unique par `/auth/register`.
model EmailVerification {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  token      String?   @unique
  createdAt  DateTime  @default(now())

  @@index([email])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())

  candidateProfile      CandidateProfile?
  recruiterProfile      RecruiterProfile?
  individualProfile     IndividualProfile?
  agentProfile          AgentProfile?
  talentAccountProfile  TalentAccountProfile?
  member                Member?

  opportunities Opportunity[]  @relation("RecruiterOpportunities")
  applications  Application[]
  bookmarks     Bookmark[]
  notifications Notification[]
  auditLogs     AuditLog[]

  talentsManaged        TalentProfile[]
  placementsAsRecruiter Placement[]     @relation("PlacementsAsRecruiter")
  placementsAsCandidate Placement[]     @relation("PlacementsAsCandidate")

  subscription        Subscription?
  transactions        Transaction[]
  sentMessages        Message[]      @relation("SentMessages")
  conversationsAsA    Conversation[] @relation("ConversationParticipantA")
  conversationsAsB    Conversation[] @relation("ConversationParticipantB")

  reportsFiled      Report[]           @relation("ReportsFiled")
  reportsAgainst    Report[]           @relation("ReportsAgainst")
  moderationActions ModerationAction[] @relation("ModerationActionsTaken")
  moderationTargets ModerationAction[] @relation("ModerationActionsReceived")
}

model CandidateProfile {
  userId                  String            @id
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                String
  phone                   String
  province                String
  city                    String
  gender                  Gender
  educationLevel          EducationLevel
  skills                  String[]
  experienceLevel         ExperienceLevel
  desiredOpportunityTypes OpportunityType[]
  availability            Availability
  cvUrl                   String?
  cvSkillsSuggested       String[]          @default([])
  /// Secteur d'intérêt déclaré — tag de filtrage, jamais une contrainte de matching.
  sector                  Sector?
}

model RecruiterProfile {
  userId      String      @id
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  phone       String
  province    String
  city        String
  sector      Sector      @default(autre)
  tier        AccountTier @default(gratuit)
}

model IndividualProfile {
  userId   String @id
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String
  province String
  city     String
}

model AgentProfile {
  userId   String @id
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String
  province String
  city     String
}

model Opportunity {
  id              String          @id @default(uuid())
  recruiterId     String
  recruiter       User            @relation("RecruiterOpportunities", fields: [recruiterId], references: [id], onDelete: Cascade)
  companyName     String
  title           String
  category        String
  /// Taxonomie transversale (filtre) — distincte de `category`, qui reste
  /// la classification fine héritée des métiers de bureau.
  sector          Sector          @default(autre)
  /// Champs additionnels dépendant du secteur (ex. outils/chantier pour le
  /// BTP, stack technique pour le digital) — même pattern que
  /// TalentVerification.checklist, pas de colonnes typées pour des champs
  /// qui ne s'appliquent qu'à une partie des secteurs.
  sectorDetails   Json?
  description     String
  province        String
  city            String
  opportunityType OpportunityType
  requiredSkills  String[]
  level           ExperienceLevel
  deadline        DateTime
  featured        Boolean         @default(false)
  createdAt       DateTime        @default(now())

  applications Application[]
  bookmarks    Bookmark[]
  talentProposals TalentOpportunityProposal[]
  placements      Placement[]

  @@index([province])
  @@index([opportunityType])
}

model Application {
  id            String            @id @default(uuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  message       String?
  status        ApplicationStatus @default(envoyee)
  createdAt     DateTime          @default(now())

  @@unique([opportunityId, candidateId])
}

model Bookmark {
  candidateId   String
  candidate     User        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([candidateId, opportunityId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Member {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  district      String
  city          String   @default("Antananarivo")
  phoneVerified Boolean  @default(false)
  joinedAt      DateTime @default(now())

  providersAdded  Provider[]                   @relation("AddedByMember")
  providersClaimed Provider[]                  @relation("ClaimedByMember")
  recommendations Recommendation[]
  confirmations   RecommendationConfirmation[]
}

model Provider {
  id                String   @id @default(uuid())
  name              String
  trade             String
  description       String   @default("")
  district          String
  city              String   @default("Antananarivo")
  province          String   @default("Antananarivo")
  phone             String
  whatsapp          String?
  addedByMemberId   String
  addedByMember     Member   @relation("AddedByMember", fields: [addedByMemberId], references: [id])
  claimedByMemberId String?
  claimedByMember   Member?  @relation("ClaimedByMember", fields: [claimedByMemberId], references: [id])
  createdAt         DateTime @default(now())

  recommendations Recommendation[]

  @@index([trade])
  @@index([district])
}

model Recommendation {
  id              String    @id @default(uuid())
  providerId      String
  provider        Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  authorMemberId  String
  authorMember    Member    @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)
  authorDistrict  String
  rating          Int
  wouldUseAgain   Boolean
  jobLabel        String
  jobDate         DateTime
  pricePaid       Int?
  priceUnit       String?
  comment         String
  proof           ProofType @default(aucune)
  createdAt       DateTime  @default(now())

  confirmations RecommendationConfirmation[]

  @@unique([providerId, authorMemberId])
  @@index([providerId])
}

model RecommendationConfirmation {
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([recommendationId, memberId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AiInteraction {
  id            String   @id @default(uuid())
  userId        String?
  feature       String
  promptSummary String
  flagged       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// Messagerie interne (candidat <-> recruteur, particulier <-> annuaire…)

model Conversation {
  id              String   @id @default(uuid())
  participantAId  String
  participantA    User     @relation("ConversationParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId  String
  participantB    User     @relation("ConversationParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  /// Contexte optionnel : l'offre à l'origine de la conversation.
  opportunityId   String?
  createdAt       DateTime @default(now())

  messages Message[]

  @@unique([participantAId, participantBId, opportunityId])
  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// Abonnements entreprise + paiement simulé

/// Grille tarifaire centralisée — jamais de prix codé en dur côté frontend.
model SubscriptionPlan {
  code                   String   @id
  name                   String
  priceAr                Int
  maxActiveOpportunities Int?
  features               String[]

  subscriptions Subscription[]
}

model Subscription {
  id          String           @id @default(uuid())
  recruiterId String           @unique
  recruiter   User             @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  planCode    String
  plan        SubscriptionPlan @relation(fields: [planCode], references: [code])
  startedAt   DateTime         @default(now())
}

/// Paiement simulé : hypothèse de démonstration, pas une intégration réelle.
model Transaction {
  id          String   @id @default(uuid())
  recruiterId String
  recruiter   User     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  type        String
  amountAr    Int
  description String
  createdAt   DateTime @default(now())

  @@index([recruiterId])
}

// Modération : Warning -> Restriction -> Suspension -> Bannissement.

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  reporter     User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  targetId     String
  /// Utilisateur responsable du contenu signalé, résolu côté serveur.
  targetUserId String?
  targetUser   User?            @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: SetNull)
  reason       String
  status       ReportStatus     @default(open)
  createdAt    DateTime         @default(now())

  moderationAction ModerationAction?

  @@index([status])
}

model ModerationAction {
  id           String               @id @default(uuid())
  reportId     String?              @unique
  report       Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)
  adminId      String
  admin        User                 @relation("ModerationActionsTaken", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?                @relation("ModerationActionsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       ModerationActionType
  note         String?
  createdAt    DateTime             @default(now())
}

// Verticale emploi vérifié : agents de terrain, talents non-diplômés,
// placements et success fee (cahier des charges §7.3, §8 phases F-I).

/// Créé et modifié uniquement par l'agent qui le suit (§7.3 règle 14) :
/// pas de compte de connexion propre au MVP.
model TalentProfile {
  id           String       @id @default(uuid())
  agentId      String
  agent        User         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  province     String
  city         String
  gender       Gender
  /// Métier déclaré à la création (repris d'un TalentLead ou saisi par
  /// l'agent) — pilote la grille de vérification standardisée (§7.3.15).
  trade        String       @default("")
  sector       Sector       @default(autre)
  skills       String[]
  availability Availability
  status       TalentStatus @default(en_attente)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  verifications TalentVerification[]
  proposals     TalentOpportunityProposal[]
  placements    Placement[]
  accountProfile TalentAccountProfile?

  @@index([agentId])
}

/// Demande de contact "je n'ai pas de diplôme mais je sais faire un
/// métier" déposée en self-service à l'inscription. Ne crée jamais elle-
/// même de TalentProfile — un agent reprend la demande et le crée
/// (§7.3.14). Peut en revanche être liée à un TalentAccountProfile
/// (compte de suivi, décision produit 2026-09-02) si la personne choisit
/// de "poursuivre vers l'inscription" après sa demande.
model TalentLead {
  id        String     @id @default(uuid())
  fullName  String
  phone     String
  province  String
  city      String
  gender    Gender
  trade     String
  sector    Sector
  message   String?
  status    LeadStatus @default(nouveau)
  createdAt DateTime   @default(now())

  accountProfile TalentAccountProfile?

  @@index([status])
}

/// Compte de suivi d'un talent non-diplômé (décision produit 2026-09-02) :
/// un vrai compte de connexion, mais qui n'a AUCUN pouvoir d'écriture sur
/// TalentProfile — il observe uniquement le statut de la demande (`lead`)
/// puis, une fois qu'un agent l'a repris, le statut réel du profil vérifié
/// (`talent`). Le profil vérifié et la grille de compétences restent
/// exclusivement créés/remplis par l'agent (§7.3.14 inchangé).
model TalentAccountProfile {
  userId   String  @id
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String
  province String
  city     String
  gender   Gender

  leadId   String?     @unique
  lead     TalentLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  talentId String?     @unique
  talent   TalentProfile? @relation(fields: [talentId], references: [id], onDelete: SetNull)
}

/// Un enregistrement par événement de vérification : historique conservé,
/// jamais écrasé (cohérent avec §7 « aucune suppression »).
model TalentVerification {
  id         String        @id @default(uuid())
  talentId   String
  talent     TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  trade      String
  checklist  Json
  note       String?
  verifiedAt DateTime      @default(now())

  @@index([talentId])
}

/// Historique des opportunités proposées à ce talent (cahier MVP §4.1) ;
/// côté « vérifié humain » d'une shortlist (§7.3 règle 17).
model TalentOpportunityProposal {
  id            String      @id @default(uuid())
  talentId      String
  talent        TalentProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  proposedAt    DateTime    @default(now())

  @@unique([talentId, opportunityId])
  @@index([opportunityId])
}

/// Exactement un de candidateId/talentId renseigné — vérifié en code
/// (validation Zod), pas en contrainte DB.
model Placement {
  id              String         @id @default(uuid())
  opportunityId   String?
  opportunity     Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  recruiterId     String
  recruiter       User           @relation("PlacementsAsRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateId     String?
  candidate       User?          @relation("PlacementsAsCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  talentId        String?
  talent          TalentProfile? @relation(fields: [talentId], references: [id], onDelete: SetNull)
  monthlySalaryAr Int?
  stage           PlacementStage @default(etape1_due)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([recruiterId])
}
