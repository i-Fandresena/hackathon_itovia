# Copiez ce fichier en .env pour le dev local. Ne jamais committer .env.

# --- Base de données ---
# 5433 car 5432 est souvent déjà pris par un PostgreSQL natif en local.
DATABASE_URL=postgresql://offrec:offrec@localhost:5433/offrec?schema=public

# --- Auth ---
JWT_SECRET=change_moi_en_local_avec_une_valeur_aleatoire_longue
JWT_EXPIRES_IN=7d
COOKIE_NAME=offrec_session

# --- IA (Gemini) ---
# Clé obtenue sur Google AI Studio (https://aistudio.google.com/apikey).
# Ne jamais exposer cette clé au frontend : elle ne doit vivre que côté serveur.
GEMINI_API_KEY=
# Modèle stable au moment de l'écriture ; ajuster selon la liste renvoyée par
# GET https://generativelanguage.googleapis.com/v1beta/models?key=VOTRE_CLE
GEMINI_MODEL=gemini-3.6-flash

# --- Email (Resend) ---
# Clé obtenue sur resend.com après avoir vérifié un domaine d'envoi (DNS
# SPF/DKIM). Sans elle, l'inscription échoue à l'étape "envoyer le code" —
# ce n'est pas un service optionnel, aucun compte ne peut être créé sans
# vérification email.
RESEND_API_KEY=
# Doit correspondre au domaine vérifié dans Resend.
RESEND_FROM_EMAIL=OffRec <verification@offrec.qualitec.mg>

# --- Serveur ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
