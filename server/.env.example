# Copiez ce fichier en .env pour le dev local. Ne jamais committer .env.

# --- Base de données ---
# 5433 car 5432 est souvent déjà pris par un PostgreSQL natif en local.
DATABASE_URL=postgresql://offrec:offrec@localhost:5433/offrec?schema=public

# --- Auth ---
JWT_SECRET=change_moi_en_local_avec_une_valeur_aleatoire_longue
JWT_EXPIRES_IN=7d
COOKIE_NAME=offrec_session

# --- IA (Gemini) ---
# Clé obtenue sur Google AI Studio (https://aistudio.google.com/apikey).
# Ne jamais exposer cette clé au frontend : elle ne doit vivre que côté serveur.
GEMINI_API_KEY=
# Modèle stable au moment de l'écriture ; ajuster selon la liste renvoyée par
# GET https://generativelanguage.googleapis.com/v1beta/models?key=VOTRE_CLE
GEMINI_MODEL=gemini-3.6-flash

# --- Email (Resend) ---
# Clé obtenue sur resend.com après avoir vérifié un domaine d'envoi (DNS
# SPF/DKIM). Sans elle, l'inscription échoue à l'étape "envoyer le code" —
# ce n'est pas un service optionnel, aucun compte ne peut être créé sans
# vérification email.
RESEND_API_KEY=
# Doit correspondre au domaine vérifié dans Resend.
RESEND_FROM_EMAIL=OffRec <verification@offrec.qualitec.mg>
# Expéditeur des emails transactionnels (ex. « votre profil a été retenu »).
# Optionnel : à défaut, RESEND_FROM_EMAIL est utilisé. Même domaine vérifié.
# Sans RESEND_API_KEY, ces emails ne partent pas (la notification dans la
# plateforme est quand même créée, et la tentative est journalisée).
RESEND_NOTIFICATION_FROM_EMAIL=OffRec <notifications@offrec.qualitec.mg>
# Optionnel : true coupe tout envoi d'email (tests, recette) ; false en
# production. Indépendamment de cette variable, aucun email ne part jamais vers
# un domaine en .invalid (RFC 2606, réservé aux comptes de test) : l'envoi est
# journalisé « skipped ».
EMAIL_SENDING_DISABLED=false

# --- Matching diplômés (lib/matching.ts) ---
# Score (0-100, scoreOpportunity) minimum pour créer une suggestion ; il faut
# en plus au moins une compétence en commun avec l'offre.
MATCH_THRESHOLD=60
# Score minimum pour l'envoi direct au recruteur, uniquement si le CV du
# candidat a été vérifié par un humain. En dessous (ou CV non vérifié), la
# suggestion attend la validation d'un admin. Jamais inférieur à MATCH_THRESHOLD.
MATCH_AUTO_THRESHOLD=80
# Nombre maximum de suggestions créées par exécution du moteur (les meilleurs
# scores d'abord).
MATCH_MAX_PER_RUN=10

# --- Agenda Google (entretiens, décision 2026-10-14 — lib/google-calendar.ts) ---
# Les entretiens fixés par les recruteurs créent un événement avec lien Google
# Meet dans l'agenda d'OffRec, SANS invité (aucune adresse échangée) et sans
# email envoyé par Google : OffRec transmet le lien à chacun. Les trois
# premières variables vides = mode simulé (aucun événement, aucun lien ;
# l'interface l'indique). Obtenir le refresh token :
#   npx tsx scripts/google-calendar-token.ts   (étapes en tête du script)
# Un événement (et un lien Meet) par tour d'entretien ; l'issue d'un entretien
# n'est jamais écrite chez Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# `primary` (agenda principal du compte) ou l'ID d'un agenda dédié
# (Paramètres de l'agenda → « Intégrer l'agenda » → « ID de l'agenda »).
GOOGLE_CALENDAR_ID=primary
# Facultatif : délai maximal d'un appel à Google, en millisecondes (défaut 8000,
# 500 au moins). Une seule nouvelle tentative en cas d'échec.
# GOOGLE_CALENDAR_TIMEOUT_MS=8000
# Recette uniquement (faux serveur Google local) : remplacent les adresses de
# Google hors production, ignorées quand NODE_ENV=production. Ne jamais les
# renseigner sur un serveur réel.
# GOOGLE_OAUTH_TOKEN_URL=
# GOOGLE_CALENDAR_API_BASE=

# --- Après l'entretien (lib/hiring-jobs.ts) ---
# true : rappel au recruteur 24 h après un entretien sans issue, résumé admin
# quotidien des issues en souffrance (> 7 jours), expiration des propositions
# d'embauche échues et rappel J-2 au candidat — au démarrage, toutes les 15 min
# et après la lecture des listes d'entretiens / « Candidats proposés ».
# Désactivé par défaut (dev, recette) ; à mettre à true en production. Un admin
# peut toujours les lancer à la main (POST /api/admin/matching/hiring-jobs/run).
# Sans ces tâches, une proposition échue est quand même traitée comme expirée.
HIRING_JOBS_ENABLED=false

# --- Serveur ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Export de recherche (sous-lot 7, POST /admin/stats/research-export) ---
# Clé des pseudonymes (HMAC) de l'export anonymisé. Facultatif : à défaut, dérivée
# de JWT_SECRET. Fixez-la pour que les pseudonymes restent stables même si
# JWT_SECRET change ; ne la communiquez jamais avec un export.
RESEARCH_EXPORT_SECRET=
